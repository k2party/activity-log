# 行動記録メモ アプリ（Podman Quadlet）
# ビルド: podman/build.sh  配置・起動: podman/deploy.sh
[Unit]
Description=行動記録メモ アプリ

[Container]
ContainerName=diary-app
Image=localhost/activity-log-app:latest
Pod=diary.pod
# SQLiteファイルを永続化（/data/activity_log.db）
Volume=diary-db_data.volume:/data
# 非rootユーザー（docker/Dockerfile の USER app, UID 10001）で実行
User=10001
# 感想の AI 要約に使う Gemini のモデルを変える場合（API キーは各ユーザーが画面で登録する）
#Environment=GEMINI_MODEL=gemini-flash-latest
# AI 要約にローカル LLM（同じ Pod の diary-llm）を使う設定。podman/deploy.sh --llm で配置すると、
# コピー先で次の2行が有効になる（モデルは podman/deploy.sh --llm <モデル名> で指定。省略時は gemma3:1b）。
# 有効にすると Gemini は使わず、API キーなしで全ユーザーが要約を使える。
# 配置先（~/.config/containers/systemd/）の定義ファイルは deploy のたびに削除してコピーし直される
#Environment=DIARY_LLM_URL=http://127.0.0.1:11434
#Environment=LLM_MODEL=gemma3:1b
# Gemini API キーを DB に暗号化して保存するための秘密鍵（32文字以上）。podman/deploy.sh が secret を
# （無ければ）生成し、コピー時に次の Secret= 行を有効にする。手動で配置する場合は secret を作成してコメントを外す:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32), end='')" | podman secret create diary-gemini-key-secret -
#Secret=diary-gemini-key-secret,type=env,target=GEMINI_KEY_SECRET
# podman build（OCI形式）では docker/Dockerfile の HEALTHCHECK が引き継がれないため、ここで定義する
HealthCmd=python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2).status == 200 else 1)"
HealthInterval=30s
HealthTimeout=3s
HealthStartPeriod=5s
HealthRetries=3

[Service]
Restart=always

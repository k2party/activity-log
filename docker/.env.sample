# Docker Compose 用の環境変数のサンプル。docker/build.sh が初回に docker/.env として作成する（秘密鍵は生成した値に置き換える）
# .env は git 管理外（.gitignore）。docker/compose.yaml が読み込む

# Gemini API キーを DB に暗号化して保存するための秘密鍵（32文字以上）。
# 下の値は仮のキーなので、本番では必ず次のコマンドで生成した値に置き換える:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 一度運用を始めたら変更しない（変更すると登録済みの API キーは全員再登録が必要になる）
GEMINI_KEY_SECRET=ACTIVITY_LOG_TOOL-GEMINI_API_KEY

# 公開するポート（127.0.0.1 のみ。既定 8000）
#APP_PORT=8000

# 感想の AI 要約に使う Gemini のモデル（既定 gemini-flash-latest）
#GEMINI_MODEL=gemini-flash-latest
